#!/bin/bash

# Railway deployment build script
# This script is executed by Railway's build system

set -e

echo "========================================="
echo "🚀 Hexaglass Deployment Build"
echo "========================================="

# Show versions
echo ""
echo "📋 Environment versions:"
echo "   PHP: $(php --version | head -1)"
echo "   Node: $(node --version)"
echo "   npm: $(npm --version)"
echo "   Composer: $(composer --version | cut -d' ' -f3)"

# PHP Build
echo ""
echo "📦 Step 1: PHP Dependency Installation..."
composer install \
  --no-interaction \
  --optimize-autoloader \
  --no-dev \
  --quiet

# Node Build
echo "📦 Step 2: Node Dependency Installation..."
npm ci --prefer-offline --no-audit --quiet

echo "🔨 Step 3: Building Frontend Assets..."
npm run build

# Laravel Preparation
echo "⚡ Step 4: Laravel Optimization..."
php artisan optimize

echo "🔗 Step 5: Creating Storage Symlink..."
php artisan storage:link || true

# Final checks
echo ""
echo "✅ Build completed successfully!"
echo "========================================="
